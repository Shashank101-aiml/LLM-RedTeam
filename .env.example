# LLM Sentinel Configuration
PROJECT_NAME="LLM Sentinel"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Safe Mode (Restricts targets to localhost / mock)
SAFE_MODE=true
ALLOWED_TARGET_HOSTS="localhost,127.0.0.1,::1,mock-target,testserver"

# Database
DATABASE_URL="sqlite+aiosqlite:///./sentinel.db"
SYNC_DATABASE_URL="sqlite:///./sentinel.db"

# API Authentication (Optional - leave empty for development mode)
SENTINEL_API_KEY=""

# Execution Bounds
MAX_CONCURRENT_TESTS=5
DEFAULT_TEST_TIMEOUT_SECONDS=15.0
